{
  "role": "Data Scientist (Classic ML)",
  "level": "middle",
  "competencies": [
    {
      "id": "linear_models",
      "name": "Линейные модели",
      "description": "Понимает линейную и логистическую регрессию, аналитическое решение и градиентный спуск.",
      "good_signals": [
        "объясняет суть линейной регрессии",
        "выводит аналитическое решение и его минусы",
        "описывает градиентный спуск и функцию потерь"
      ],
      "keywords": ["линейн", "логистическ", "градиентн", "веса", "аналитическ", "регресс"]
    },
    {
      "id": "regularization",
      "name": "Регуляризация",
      "description": "Объясняет L1/L2, их эффект на веса и геометрическую интерпретацию.",
      "good_signals": [
        "различает L1 и L2",
        "объясняет зануление весов",
        "даёт геометрическую интерпретацию"
      ],
      "keywords": ["регуляриз", "l1", "l2", "lasso", "ridge", "elastic", "зануля"]
    },
    {
      "id": "overfitting",
      "name": "Переобучение",
      "description": "Понимает причины переобучения и способы борьбы с ним.",
      "good_signals": [
        "определяет переобучение через разрыв train/test",
        "перечисляет способы борьбы",
        "связывает со сложностью модели"
      ],
      "keywords": ["переобуч", "обобщающ", "шум", "выброс", "сложн"]
    },
    {
      "id": "validation",
      "name": "Валидация",
      "description": "Строит кросс-валидацию, учитывает временные ряды.",
      "good_signals": [
        "объясняет k-fold",
        "понимает утечку времени",
        "применяет time series split"
      ],
      "keywords": ["кросс-валидац", "фолд", "валидац", "time series", "отложен", "хронолог"]
    },
    {
      "id": "metrics",
      "name": "Метрики классификации",
      "description": "Знает метрики классификации и смысл ROC-AUC.",
      "good_signals": [
        "перечисляет precision/recall",
        "строит и считает ROC-AUC",
        "интерпретирует проблемные участки кривой"
      ],
      "keywords": ["метрик", "roc", "auc", "рокаук", "precision", "recall", "порог", "false positive"]
    }
  ]
}
